# kkRepo image. Keep 1.1.0 for reproducible/manual upgrades.
# Use latest only if you deliberately want Dockwatch to follow new kkRepo releases.
KKREPO_IMAGE_TAG=1.1.0

# Host port for direct Compose testing. The Saltbox role will use Traefik instead.
KKREPO_HTTP_PORT=19090

# Database
KKREPO_MYSQL_DATABASE=kkrepo
KKREPO_MYSQL_USER=kkrepo
KKREPO_MYSQL_PASSWORD=CHANGE_ME
KKREPO_MYSQL_ROOT_PASSWORD=CHANGE_ME

# Generate each secret independently, e.g.:
#   openssl rand -hex 32
KKREPO_CREDENTIAL_SECRET=CHANGE_ME
KKREPO_API_KEY_PAYLOAD_SECRET=CHANGE_ME

TZ=Europe/Berlin
KKREPO_DB_TIMEZONE=Europe/Berlin
KKREPO_TOMCAT_MAX_PART_COUNT=200
